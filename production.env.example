# Production configuration. Store real values in AWS Secrets Manager or SSM,
# inject them into the backend container, and do not commit the resulting file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://DATABASE_USER:DATABASE_PASSWORD@RDS_ENDPOINT:5432/DATABASE_NAME?sslmode=require
BACKEND_CORS_ORIGINS=https://APP_PUBLIC_HOSTNAME

# This is a build argument for the frontend image, not a runtime variable.
# Leave empty when an ingress/reverse proxy routes /api to the backend.
VITE_API_BASE_URL=https://API_PUBLIC_HOSTNAME
