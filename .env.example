# Local Docker development configuration. Do not use these credentials in AWS.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/securedataops
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:5173
# Local-only value for testing bearer JWT protection. Use a managed secret in production.
AUTH_JWT_SECRET=replace-with-a-development-only-secret-of-at-least-32-characters
AUTH_JWT_ISSUER=securedataops-local
AUTH_JWT_AUDIENCE=securedataops-api
VITE_API_BASE_URL=http://localhost:8000
